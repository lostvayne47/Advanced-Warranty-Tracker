# Reference only: Spring Boot does not automatically load this file.
# Set these in your shell or hosting environment. Never commit actual secrets.
JWT_SECRET=
# Optional: Gemini image parsing, configured on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGINS=http://localhost:5173
PORT=5000
# Required for the default PostgreSQL profile; unused by the local profile.
DB_URL=jdbc:postgresql://localhost:5432/warranty_tracker
DB_USERNAME=postgres
DB_PASSWORD=

# Use SPRING_PROFILES_ACTIVE=supabase for a hosted Supabase project.
# Copy the exact host/user from the project's Connect dialog (session mode).
SUPABASE_DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Legacy service_role API key, server-only; never an anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=
# For local H2 + remote storage only, set true. Supabase profile enables it.
SUPABASE_STORAGE_ENABLED=false
