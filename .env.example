# Copy to .env for Docker Compose only; never commit actual secrets.
# Deploy behind an HTTPS reverse proxy; application port binds to loopback.
APP_PORT=8080
RELEASE_TAG=local
CORS_ORIGINS=https://warranties.example.com
JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=
